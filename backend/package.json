{
  "name": "@devspace/backend",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npx esbuild src/app.ts --bundle --platform=node --format=esm --outfile=app.mjs --external:fastify --external:pg --external:@electric-sql/pglite",
    "start": "node ./dist/server.js",
    "dev": "node --watch --loader ts-node/esm ./src/server.ts",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@devspace/shared": "*",
    "@electric-sql/pglite": "^0.2.14",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/static": "^6.12.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "kysely": "^0.27.3",
    "marked": "^12.0.2",
    "pg": "^8.11.5",
    "sanitize-html": "^2.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/sanitize-html": "^2.11.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5"
  }
}
