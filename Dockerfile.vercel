# Multi-stage production build for DevSpace Backend on Vercel Container Runtime
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY package*.json ./
COPY shared/package*.json ./shared/
COPY backend/package*.json ./backend/

# Install all dependencies including devDependencies for build
RUN npm ci

# Copy source tree
COPY shared ./shared
COPY backend ./backend
COPY tsconfig.json ./

# Build shared and backend workspaces
RUN npm run build --workspace=@devspace/shared && npm run build --workspace=@devspace/backend

# Stage 2: Production runtime image
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV HOST=0.0.0.0

# Install production dependencies only
COPY package*.json ./
COPY shared/package*.json ./shared/
COPY backend/package*.json ./backend/

RUN npm ci --omit=dev

# Copy compiled artifacts
COPY --from=builder /app/shared/dist ./shared/dist
COPY --from=builder /app/backend/dist ./backend/dist

# Create storage directory for media uploads
RUN mkdir -p .data/storage/raw-uploads .data/storage/processed

CMD ["node", "backend/dist/server.js"]
